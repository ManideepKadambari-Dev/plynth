{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ] }
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC x64",
      "inherits": "base"
    }
  ],
  "buildPresets": [
    { "name": "debug", "displayName": "Debug", "configurePreset": "msvc", "configuration": "Debug", "jobs": 4 },
    { "name": "release", "displayName": "Release", "configurePreset": "msvc", "configuration": "Release", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "debug", "displayName": "Debug", "configurePreset": "msvc", "configuration": "Debug",
      "output": { "outputOnFailure": true }, "execution": { "jobs": 1 }
    },
    {
      "name": "release", "displayName": "Release", "configurePreset": "msvc", "configuration": "Release",
      "output": { "outputOnFailure": true }, "execution": { "jobs": 1 }
    }
  ]
}
