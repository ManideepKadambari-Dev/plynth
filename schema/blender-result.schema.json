{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plynth:schema:blender-result:1",
  "title": "Plynth Blender result, version 1",
  "description": "Written by the Blender worker to the result_file of its job, through a temporary file and a rename, as the last thing it does. Task and job_id repeat the job's. With ok false, error says why and output is null. Lengths are metres.",
  "type": "object",
  "required": ["format", "version", "task", "job_id", "ok", "error", "blender_version", "warnings", "elapsed_ms", "output"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "plynth-blender-result" },
    "version": { "const": 1 },
    "task": { "type": "string" },
    "job_id": { "type": "string" },
    "ok": { "type": "boolean" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "enum": ["bad_job", "unknown_task", "unsupported_format", "import_failed", "no_geometry", "several_models", "several_materials", "no_base_color", "bake_failed", "unpack_failed", "save_failed", "render_failed", "export_failed", "preferences_unreadable", "internal"] },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "blender_version": { "description": "For example 5.2.0.", "type": "string" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "enum": ["high_polycount", "scale_suspicious", "missing_texture", "removed_objects", "unsupported_object", "fbx_failed", "ambiguous_map", "unused_image", "map_size_mismatch", "visible_seams", "low_resolution", "material_approximated"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "output": { "type": ["object", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "properties": { "error": { "type": "null" }, "output": { "type": "object" } } },
      "else": { "properties": { "error": { "type": "object" }, "output": { "type": "null" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "task": { "const": "probe" } } },
      "then": { "properties": { "output": { "$ref": "#/definitions/probeOutput" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "task": { "const": "cleanup_asset" } } },
      "then": { "properties": { "output": { "$ref": "#/definitions/cleanupOutput" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "task": { "const": "render_thumbnail" } } },
      "then": { "properties": { "output": { "$ref": "#/definitions/thumbnailOutput" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "task": { "const": "build" } } },
      "then": { "properties": { "output": { "$ref": "#/definitions/buildOutput" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "task": { "const": "cleanup_material" } } },
      "then": { "properties": { "output": { "$ref": "#/definitions/cleanupMaterialOutput" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "task": { "const": "export" } } },
      "then": { "properties": { "output": { "$ref": "#/definitions/exportOutput" } } }
    }
  ],
  "definitions": {
    "size": {
      "type": "object",
      "required": ["width", "depth", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 0 },
        "depth": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "thumbnail": {
      "type": "object",
      "required": ["file", "engine", "error"],
      "additionalProperties": false,
      "properties": {
        "file": { "description": "The file name inside the output folder, or null when the render failed.", "type": ["string", "null"] },
        "engine": { "description": "Thumbnails are rendered with Eevee only.", "enum": ["eevee", null] },
        "error": { "type": ["string", "null"] }
      }
    },
    "probeOutput": {
      "type": "object",
      "required": ["blender", "addons", "blenderkit"],
      "additionalProperties": false,
      "properties": {
        "blender": {
          "type": "object",
          "required": ["version", "version_text", "python", "build_date"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "version_text": { "type": "string" },
            "python": { "type": "string" },
            "build_date": { "type": "string" }
          }
        },
        "addons": {
          "description": "Only add-ons and extensions that are both saved as enabled and found on disk.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "name", "version"],
            "additionalProperties": false,
            "properties": {
              "module": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "blenderkit": {
          "description": "installed means found on disk. signed_in only says whether a sign-in is saved. The key is never output.",
          "type": "object",
          "required": ["installed", "enabled", "signed_in"],
          "additionalProperties": false,
          "properties": {
            "installed": { "type": "boolean" },
            "enabled": { "type": "boolean" },
            "signed_in": { "type": "boolean" }
          }
        }
      }
    },
    "cleanupOutput": {
      "type": "object",
      "required": ["blend_file", "fbx_file", "picked_file", "size", "triangles", "objects", "materials", "textures", "missing_textures", "material_maps", "thumbnail"],
      "additionalProperties": false,
      "properties": {
        "material_maps": {
          "description": "The image maps of each material, one per entry of materials, in the same order (core/include/plynth/core/catalog/AssetJobs.h).",
          "type": "array",
          "items": { "$ref": "#/definitions/assetMaterialMaps" }
        },
        "blend_file": { "const": "asset.blend" },
        "fbx_file": { "description": "asset.fbx for the live preview, or null when its export failed (warning fbx_failed).", "enum": ["asset.fbx", null] },
        "picked_file": { "description": "The model used from inside a zip, relative to the zip. Null for other sources.", "type": ["string", "null"] },
        "size": { "$ref": "#/definitions/size" },
        "triangles": { "type": "integer", "minimum": 0 },
        "objects": { "type": "integer", "minimum": 1 },
        "materials": { "type": "array", "items": { "type": "string" } },
        "textures": { "type": "array", "items": { "type": "string" } },
        "missing_textures": { "description": "Image files the model names that were not found.", "type": "array", "items": { "type": "string" } },
        "thumbnail": { "$ref": "#/definitions/thumbnail" }
      }
    },
    "thumbnailOutput": {
      "type": "object",
      "required": ["size", "triangles", "objects", "materials", "textures", "fbx_file", "thumbnail"],
      "additionalProperties": false,
      "properties": {
        "size": { "oneOf": [{ "$ref": "#/definitions/size" }, { "type": "null" }] },
        "triangles": { "type": ["integer", "null"], "minimum": 0 },
        "objects": { "type": ["integer", "null"], "minimum": 0 },
        "materials": { "type": ["array", "null"], "items": { "type": "string" } },
        "textures": { "type": ["array", "null"], "items": { "type": "string" } },
        "fbx_file": { "description": "The file name written for the job's fbx_file, or null when none was asked for or the export failed.", "type": ["string", "null"] },
        "thumbnail": { "$ref": "#/definitions/thumbnail" }
      }
    },
    "buildProblem": {
      "description": "Something about one object that the build left out or that should be checked. object is the plan id the app marks.",
      "type": "object",
      "required": ["code", "severity", "message", "floor", "object", "step"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z_]+$" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string", "minLength": 1 },
        "floor": { "type": ["string", "null"] },
        "object": { "type": ["string", "null"] },
        "step": { "type": "string", "minLength": 1 }
      }
    },
    "buildOutput": {
      "type": "object",
      "required": ["blend_file", "fbx_file", "materials_file", "objects", "triangles", "counts", "steps", "problems"],
      "additionalProperties": false,
      "properties": {
        "blend_file": { "const": "building.blend" },
        "fbx_file": { "enum": ["building.fbx", null] },
        "materials_file": { "description": "Written with the FBX; null when no FBX was asked for.", "enum": ["materials.json", null] },
        "objects": { "type": "integer", "minimum": 0 },
        "triangles": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "required": ["wall_solids", "openings_cut", "fills", "rooms", "items", "materials", "collision", "slabs", "stairs", "roofs"],
          "additionalProperties": false,
          "properties": {
            "wall_solids": { "type": "integer", "minimum": 0 },
            "openings_cut": { "type": "integer", "minimum": 0 },
            "fills": { "type": "integer", "minimum": 0 },
            "rooms": { "type": "integer", "minimum": 0 },
            "items": { "type": "integer", "minimum": 0 },
            "materials": { "description": "Blender materials made for built surfaces, one per slot.", "type": "integer", "minimum": 0 },
            "collision": { "description": "UCX_ collision meshes made: pieces and item hulls.", "type": "integer", "minimum": 0 },
            "slabs": { "description": "Slab meshes made.", "type": "integer", "minimum": 0 },
            "stairs": { "description": "Stair meshes made.", "type": "integer", "minimum": 0 },
            "roofs": { "description": "Roof section meshes made.", "type": "integer", "minimum": 0 }
          }
        },
        "steps": {
          "description": "Every step that ran, in order, with how long it took.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "ms"],
            "additionalProperties": false,
            "properties": {
              "step": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "ms": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "problems": { "type": "array", "items": { "$ref": "#/definitions/buildProblem" } }
      }
    },
    "mapFile": {
      "description": "Relative to output_folder: textures/<channel>.<ext>, for example textures/normal.png.",
      "type": "string",
      "pattern": "^textures/(base_color|normal|roughness|metallic|opacity|occlusion)\\.(png|jpg|jpeg)$"
    },
    "materialMap": {
      "description": "from: file (detail is the source image's name), value (detail is the number), baked (rendered with Eevee), none (no map).",
      "type": "object",
      "required": ["file", "from", "detail"],
      "additionalProperties": false,
      "properties": {
        "file": { "oneOf": [{ "$ref": "#/definitions/mapFile" }, { "type": "null" }] },
        "from": { "enum": ["file", "value", "baked", "none"] },
        "detail": { "type": "string" }
      },
      "if": { "properties": { "from": { "const": "none" } } },
      "then": { "properties": { "file": { "type": "null" } } },
      "else": { "properties": { "file": { "$ref": "#/definitions/mapFile" } } }
    },
    "requiredMap": {
      "allOf": [
        { "$ref": "#/definitions/materialMap" },
        { "properties": { "from": { "enum": ["file", "value", "baked"] } } }
      ]
    },
    "assetMapFile": {
      "description": "Relative to the asset's item folder: textures/maps/<key>/<channel>.<ext>, or a scaled copy textures/preview/<name>.<ext>.",
      "type": "string",
      "pattern": "^textures/(maps|preview)/[A-Za-z0-9_./-]+\\.(png|jpg|jpeg)$"
    },
    "assetMap": {
      "type": "object",
      "required": ["file", "from", "detail"],
      "additionalProperties": false,
      "properties": {
        "file": { "oneOf": [{ "$ref": "#/definitions/assetMapFile" }, { "type": "null" }] },
        "from": { "enum": ["file", "value", "baked", "none"] },
        "detail": { "type": "string" }
      },
      "if": { "properties": { "from": { "const": "none" } } },
      "then": { "properties": { "file": { "type": "null" } } },
      "else": { "properties": { "file": { "$ref": "#/definitions/assetMapFile" } } }
    },
    "assetMaps": {
      "type": "object",
      "required": ["base_color", "normal", "roughness", "metallic", "opacity", "occlusion"],
      "additionalProperties": false,
      "properties": {
        "base_color": { "allOf": [{ "$ref": "#/definitions/assetMap" }, { "properties": { "from": { "enum": ["file", "value", "baked"] } } }] },
        "normal": { "allOf": [{ "$ref": "#/definitions/assetMap" }, { "properties": { "from": { "enum": ["file", "value", "baked"] } } }] },
        "roughness": { "allOf": [{ "$ref": "#/definitions/assetMap" }, { "properties": { "from": { "enum": ["file", "value", "baked"] } } }] },
        "metallic": { "allOf": [{ "$ref": "#/definitions/assetMap" }, { "properties": { "from": { "enum": ["file", "value", "baked"] } } }] },
        "opacity": { "$ref": "#/definitions/assetMap" },
        "occlusion": { "$ref": "#/definitions/assetMap" }
      }
    },
    "assetMaterialMaps": {
      "description": "maps are the full size files under textures/maps/; preview_maps are what asset.fbx uses: the same file when it is no larger than 1024 px on a side, otherwise its scaled copy under textures/preview/.",
      "type": "object",
      "required": ["name", "maps", "preview_maps"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "maps": { "$ref": "#/definitions/assetMaps" },
        "preview_maps": { "$ref": "#/definitions/assetMaps" }
      }
    },
    "qualityCheck": {
      "description": "One quality check of the export (core/include/plynth/core/ExportJob.h). fail blocks the export unless it is forced.",
      "type": "object",
      "required": ["id", "name", "phase", "status", "message", "findings"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["scene", "file"] },
        "status": { "enum": ["pass", "warning", "fail", "skipped"] },
        "message": { "type": "string", "minLength": 1 },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["object", "plan_id", "message"],
            "additionalProperties": false,
            "properties": {
              "object": { "description": "The exported object or slot, or null.", "type": ["string", "null"] },
              "plan_id": { "description": "The plan id the app can select, or null.", "type": ["string", "null"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "exportOutput": {
      "type": "object",
      "required": ["written", "files", "textures", "objects", "triangles", "collision_objects", "checks", "steps"],
      "additionalProperties": false,
      "properties": {
        "written": { "description": "The group files and Textures/ are in the job's output_folder.", "type": "boolean" },
        "files": {
          "description": "Empty when written is false.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "file", "objects", "triangles"],
            "additionalProperties": false,
            "properties": {
              "group": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "file": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.fbx$" },
              "objects": { "type": "integer", "minimum": 0 },
              "triangles": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "textures": {
          "description": "File names inside Textures/. Empty when written is false.",
          "type": "array",
          "items": { "type": "string", "pattern": "^T_[A-Za-z0-9_]+\\.(png|jpg|jpeg|tga|tif|tiff|bmp|exr)$" }
        },
        "objects": { "description": "Exported meshes, collision included.", "type": "integer", "minimum": 0 },
        "triangles": { "type": "integer", "minimum": 0 },
        "collision_objects": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/qualityCheck" } },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "ms"],
            "additionalProperties": false,
            "properties": {
              "step": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "cleanupMaterialOutput": {
      "type": "object",
      "required": ["maps", "texture_size", "tile_size", "picked_material", "source_info", "thumbnail"],
      "additionalProperties": false,
      "properties": {
        "maps": {
          "type": "object",
          "required": ["base_color", "normal", "roughness", "metallic", "opacity", "occlusion"],
          "additionalProperties": false,
          "properties": {
            "base_color": { "$ref": "#/definitions/requiredMap" },
            "normal": { "$ref": "#/definitions/requiredMap" },
            "roughness": { "$ref": "#/definitions/requiredMap" },
            "metallic": { "$ref": "#/definitions/requiredMap" },
            "opacity": { "$ref": "#/definitions/materialMap" },
            "occlusion": { "$ref": "#/definitions/materialMap" }
          }
        },
        "texture_size": {
          "description": "Pixel size of the base color map.",
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "tile_size": {
          "description": "The tile size used: the job's, material.json's, or 1 m square.",
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "minimum": 0.01, "maximum": 100 },
            "height": { "type": "number", "minimum": 0.01, "maximum": 100 }
          }
        },
        "picked_material": { "description": "The material taken from a .blend; null for a texture set.", "type": ["string", "null"] },
        "source_info": {
          "description": "What material.json said, each field only when it was there; null when there was no material.json.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
                "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                "groups": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
                "tags": { "type": "array", "items": { "type": "string" } },
                "license": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              }
            }
          ]
        },
        "thumbnail": { "$ref": "#/definitions/thumbnail" }
      }
    }
  }
}
