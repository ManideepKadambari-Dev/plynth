{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plynth:schema:blender-job:1",
  "title": "Plynth Blender job, version 1",
  "description": "Written by Plynth as job.json in a work folder and passed to Blender with: blender --background [--factory-startup] -noaudio --python-exit-code 3 --python <scripts>/plynth_worker.py -- --job <work>/job.json. The worker runs the task and writes the result file named by result_file (schema blender-result). While it runs it prints progress lines of the form PLYNTH:{\"progress\": {\"step\": \"...\", \"index\": 1, \"count\": 9, \"message\": \"...\"}}. Paths are absolute with forward slashes. Lengths are metres.",
  "type": "object",
  "required": ["format", "version", "task", "job_id", "result_file", "params"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "plynth-blender-job" },
    "version": { "const": 1 },
    "task": { "description": "A task of the worker's task registry (blender/plynth/tasks/).", "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "job_id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "minLength": 1 },
    "result_file": { "type": "string", "minLength": 1 },
    "params": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "task": { "const": "probe" } } },
      "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } }
    },
    {
      "if": { "properties": { "task": { "const": "cleanup_asset" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["source", "asset_id", "output_folder", "scale", "rotate_z", "triangle_warning", "thumbnail"],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "object",
                "required": ["file", "format"],
                "additionalProperties": false,
                "properties": {
                  "file": { "type": "string", "minLength": 1 },
                  "format": { "description": "An importer of the worker's importer registry (blender/plynth/importers/).", "enum": ["blend", "fbx", "obj", "gltf", "zip"] }
                }
              },
              "asset_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
              "output_folder": { "description": "An empty folder. The worker writes asset.blend, textures/ and thumb.png into it.", "type": "string", "minLength": 1 },
              "scale": { "type": "number", "exclusiveMinimum": 0 },
              "rotate_z": { "enum": [0, 90, 180, 270] },
              "triangle_warning": { "type": "integer", "minimum": 1 },
              "thumbnail": { "$ref": "#/definitions/thumbnail" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "task": { "const": "render_thumbnail" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["blend_file", "output_file", "measure", "fbx_file", "thumbnail"],
            "additionalProperties": false,
            "properties": {
              "blend_file": { "description": "Opened and never saved.", "type": "string", "minLength": 1 },
              "output_file": { "type": "string", "minLength": 1 },
              "measure": { "type": "boolean" },
              "fbx_file": { "description": "Where to export the model as asset.fbx for the live preview, or null for no export.", "type": ["string", "null"], "minLength": 1 },
              "thumbnail": { "$ref": "#/definitions/thumbnail" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "task": { "const": "build" } } },
      "then": {
        "properties": {
          "params": {
            "description": "Everything the build needs. plan is plan.json as saved; floors holds the shapes core worked out from it (core/include/plynth/core/BuildGeometry.h). All positions are Blender world coordinates in metres: X = plan x, Y = -plan y, Z up from the first floor's level. Outer rings run anticlockwise seen from above, holes clockwise, the first point not repeated.",
            "type": "object",
            "required": ["project", "output_folder", "blend_file", "fbx_file", "materials_file", "textures_folder", "plan", "settings", "assets", "materials", "floors"],
            "additionalProperties": false,
            "properties": {
              "project": {
                "type": "object",
                "required": ["name", "folder"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "folder": { "type": "string", "minLength": 1 }
                }
              },
              "output_folder": { "description": "The project's build folder. The worker writes blend_file and fbx_file into it, each under a temporary name first and renamed at the end.", "type": "string", "minLength": 1 },
              "blend_file": { "const": "building.blend" },
              "fbx_file": { "description": "The FBX the 3D preview loads, or null for none.", "enum": ["building.fbx", null] },
              "materials_file": { "description": "Written with the FBX into output_folder (schema/build-materials.schema.json): the images of every channel of each built material, for the 3D preview. null exactly when fbx_file is null.", "enum": ["materials.json", null] },
              "textures_folder": { "description": "The folder in output_folder for the constant images of the neutral looks.", "const": "textures" },
              "plan": { "description": "plan.json as saved, schema/plan.schema.json.", "type": "object" },
              "settings": {
                "type": "object",
                "required": ["bevel_width", "bevel_segments", "fill_openings"],
                "additionalProperties": false,
                "properties": {
                  "bevel_width": { "description": "Metres. 0 leaves edges sharp.", "type": "number", "minimum": 0, "maximum": 0.05 },
                  "bevel_segments": { "type": "integer", "minimum": 1, "maximum": 8 },
                  "fill_openings": { "description": "Put a door or a window into every door and window opening.", "type": "boolean" }
                }
              },
              "assets": {
                "description": "Each asset the items use, once.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "blend_file", "collection"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "$ref": "#/definitions/catalogId" },
                    "blend_file": { "type": "string", "minLength": 1 },
                    "collection": { "description": "The collection in blend_file that holds the asset, named after its id.", "$ref": "#/definitions/catalogId" }
                  }
                }
              },
              "materials": {
                "description": "Each library material the built surfaces use, once, sorted by id. Every material field of the floors names one of these or is null (the neutral look).",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "tile_size", "maps"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "$ref": "#/definitions/catalogId" },
                    "tile_size": { "$ref": "#/definitions/tileSize" },
                    "maps": {
                      "description": "Absolute paths. base_color is sRGB, the rest linear; grey maps are read from the red channel; normal is OpenGL.",
                      "type": "object",
                      "required": ["base_color", "normal", "roughness", "metallic", "opacity", "occlusion"],
                      "additionalProperties": false,
                      "properties": {
                        "base_color": { "type": "string", "minLength": 1 },
                        "normal": { "type": "string", "minLength": 1 },
                        "roughness": { "type": "string", "minLength": 1 },
                        "metallic": { "type": "string", "minLength": 1 },
                        "opacity": { "description": "null for an opaque material.", "type": ["string", "null"], "minLength": 1 },
                        "occlusion": { "type": ["string", "null"], "minLength": 1 }
                      }
                    }
                  }
                }
              },
              "floors": { "type": "array", "items": { "$ref": "#/definitions/buildFloor" } },
              "generators": {
                "description": "Each generator file a built generator item uses, once, sorted by id (core/include/plynth/core/GeneratorBuild.h). Missing means none.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "file", "addons"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "$ref": "#/definitions/catalogId" },
                    "file": { "description": "Absolute path of the .py file in Library/generators.", "type": "string", "minLength": 1 },
                    "addons": { "description": "Short module names of the add-ons it needs.", "type": "array", "items": { "$ref": "#/definitions/catalogId" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "task": { "const": "cleanup_material" } } },
      "then": {
        "properties": {
          "params": {
            "description": "Make every map of one material into output_folder/textures/ and render output_folder/thumb.png (core/include/plynth/core/catalog/MaterialJobs.h). Blender's own baking is never used: it needs Cycles.",
            "type": "object",
            "required": ["source", "output_folder", "tile_size", "bake_size", "thumbnail"],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "object",
                "required": ["kind", "path", "material", "maps", "values", "normal"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "description": "A source of the worker's material source registry (blender/plynth/materials/sources/).", "enum": ["texture_set", "blend"] },
                  "path": { "description": "texture_set: a folder, a zip or one image file. blend: a .blend file, opened and never saved.", "type": "string", "minLength": 1 },
                  "material": { "description": "blend: the material's name, or null for the only one. Always null for texture_set.", "type": ["string", "null"], "minLength": 1 },
                  "maps": {
                    "description": "Absolute image files the user picked for channels. They win over names and material.json.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "base_color": { "type": "string", "minLength": 1 },
                      "normal": { "type": "string", "minLength": 1 },
                      "roughness": { "type": "string", "minLength": 1 },
                      "metallic": { "type": "string", "minLength": 1 },
                      "opacity": { "type": "string", "minLength": 1 },
                      "occlusion": { "type": "string", "minLength": 1 }
                    }
                  },
                  "values": {
                    "description": "Single values for channels without an image. They win over material.json.",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "roughness": { "$ref": "#/definitions/unit" },
                      "metallic": { "$ref": "#/definitions/unit" },
                      "opacity": { "$ref": "#/definitions/unit" },
                      "occlusion": { "$ref": "#/definitions/unit" }
                    }
                  },
                  "normal": { "description": "auto reads the convention from the normal map's name (gl or opengl, dx or directx) and takes OpenGL otherwise. DirectX maps get their green channel flipped.", "enum": ["auto", "opengl", "directx"] }
                }
              },
              "output_folder": { "description": "An empty folder. The worker writes textures/<channel>.<ext> and thumb.png into it.", "type": "string", "minLength": 1 },
              "tile_size": { "description": "null: material.json's, otherwise 1 m square.", "oneOf": [{ "$ref": "#/definitions/tileSize" }, { "type": "null" }] },
              "bake_size": { "description": "Pixels across a channel rendered with Eevee.", "enum": [256, 512, 1024, 2048, 4096] },
              "thumbnail": { "$ref": "#/definitions/thumbnail" }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "thumbnail": {
      "description": "Assets: three quarter view from the front right, 25 degrees up, 50 mm lens, framed with an 8 percent margin. Materials: a sphere 1 m across and a flat tile 1 m square side by side at real world size. Both: neutral studio lights, a plain background of this color, Standard view transform, square 8 bit RGB PNG, rendered with Eevee. There is no other engine.",
      "type": "object",
      "required": ["render", "size", "background"],
      "additionalProperties": false,
      "properties": {
        "render": { "type": "boolean" },
        "size": { "type": "integer", "minimum": 64, "maximum": 2048 },
        "background": {
          "description": "sRGB, 0 to 1.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "catalogId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "materialRef": {
      "description": "The id of an entry of the build's materials list, or null for the neutral look of the surface.",
      "oneOf": [{ "$ref": "#/definitions/catalogId" }, { "type": "null" }]
    },
    "tileSize": {
      "description": "The real world size of one tile in metres: width along U, height along V.",
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 0.01, "maximum": 100 },
        "height": { "type": "number", "minimum": 0.01, "maximum": 100 }
      }
    },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "planId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "xy": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/xy" } },
    "wallRing": {
      "description": "A ring of a wall solid. edges[i] is the side face standing on the edge from points[i] to points[i + 1], the last back to the first. The solid is to the left of each edge seen from above.",
      "type": "object",
      "required": ["points", "edges"],
      "additionalProperties": false,
      "properties": {
        "points": { "$ref": "#/definitions/points" },
        "edges": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["wall", "side", "room", "material"],
            "additionalProperties": false,
            "properties": {
              "wall": { "$ref": "#/definitions/planId" },
              "side": { "description": "The face of the wall this edge belongs to, or null for an end face across the wall.", "enum": ["left", "right", null] },
              "room": { "description": "The room the face looks into, or null when it looks into no room.", "oneOf": [{ "$ref": "#/definitions/planId" }, { "type": "null" }] },
              "material": { "description": "The material of the face: the wall's inside material for its room, or its outside one when room is null.", "$ref": "#/definitions/materialRef" }
            }
          }
        }
      }
    },
    "buildFloor": {
      "type": "object",
      "required": ["id", "elevation", "ceiling_height", "wall_solids", "openings", "rooms", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/planId" },
        "elevation": { "description": "The floor's level above the first floor's.", "type": "number" },
        "ceiling_height": { "type": "number", "exclusiveMinimum": 0 },
        "wall_solids": {
          "description": "The floor's walls as solids of one height each that never overlap, tallest first.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["height", "top_material", "outline", "holes"],
            "additionalProperties": false,
            "properties": {
              "height": { "description": "Above the floor's level.", "type": "number", "exclusiveMinimum": 0 },
              "top_material": { "description": "The material of the solid's top and bottom faces.", "$ref": "#/definitions/materialRef" },
              "outline": { "$ref": "#/definitions/wallRing" },
              "holes": { "type": "array", "items": { "$ref": "#/definitions/wallRing" } }
            }
          }
        },
        "openings": { "type": "array", "items": { "$ref": "#/definitions/buildOpening" } },
        "rooms": {
          "description": "Rooms whose walls close, each with its floor area.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "area", "floor_z", "ceiling_z", "floor_material", "ceiling_material", "polygons"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/planId" },
              "type": { "type": ["string", "null"] },
              "floor_material": { "$ref": "#/definitions/materialRef" },
              "ceiling_material": { "$ref": "#/definitions/materialRef" },
              "area": { "description": "Square metres, the same area the app shows.", "type": "number", "minimum": 0 },
              "floor_z": { "type": "number" },
              "ceiling_z": { "type": "number" },
              "polygons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["outline", "holes"],
                  "additionalProperties": false,
                  "properties": {
                    "outline": { "$ref": "#/definitions/points" },
                    "holes": { "type": "array", "items": { "$ref": "#/definitions/points" } }
                  }
                }
              }
            }
          }
        },
        "items": {
          "description": "Items whose asset is in the job's assets list.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "asset", "location", "rotation_z", "size", "wall"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/planId" },
              "asset": { "$ref": "#/definitions/catalogId" },
              "location": { "description": "Where the asset's pivot (bottom centre) goes.", "$ref": "#/definitions/xyz" },
              "rotation_z": { "description": "Radians about Z: minus the plan rotation.", "type": "number" },
              "size": {
                "type": "object",
                "required": ["width", "depth", "height"],
                "additionalProperties": false,
                "properties": {
                  "width": { "type": "number", "exclusiveMinimum": 0 },
                  "depth": { "type": "number", "exclusiveMinimum": 0 },
                  "height": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "wall": { "oneOf": [{ "$ref": "#/definitions/planId" }, { "type": "null" }] }
            }
          }
        },
        "generator_items": {
          "description": "Items that run a generator of the job's generators list, in the floor's item order. Missing means none.",
          "type": "array",
          "items": { "$ref": "#/definitions/buildGeneratorItem" }
        }
      }
    },
    "buildGeneratorItem": {
      "description": "The worker calls the generator's generate(gen) with these values, joins the meshes it returns into SM_<generator>_<id> and places it like an item: its bottom centre at location, turned by rotation_z.",
      "type": "object",
      "required": ["id", "generator", "params", "location", "rotation_z", "size", "room", "wall"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/planId" },
        "generator": { "$ref": "#/definitions/catalogId" },
        "params": {
          "description": "Every declared parameter, after core fitted them to the declaration. Numbers in metres or degrees. A material value is the id of an entry of the job's materials list, or null for the neutral look Generated.",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/catalogId" },
          "additionalProperties": { "type": ["number", "boolean", "string", "null"] }
        },
        "location": { "description": "Where the result's bottom centre goes.", "$ref": "#/definitions/xyz" },
        "rotation_z": { "description": "Radians about Z: minus the plan rotation.", "type": "number" },
        "size": {
          "description": "The size the declaration gives for these values; the worker warns generator_size when the result reaches more than 1 cm past it.",
          "type": "object",
          "required": ["width", "depth", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "room": { "oneOf": [{ "$ref": "#/definitions/planId" }, { "type": "null" }] },
        "wall": { "oneOf": [{ "$ref": "#/definitions/planId" }, { "type": "null" }] }
      }
    },
    "buildOpening": {
      "description": "An opening that fits its wall. The opening's own box: u along the wall from -width/2 (Start jamb) to width/2, v up from 0 at the sill. Point (u, v, w), w across the wall toward its right side, is at centre + tangent * u + right * w in X and Y and at Z = floor level + sill + v.",
      "type": "object",
      "required": ["id", "wall", "type", "shape", "width", "height", "sill", "hinge", "swing", "frame", "centre", "tangent", "right", "thickness", "curved", "outline", "inner_outline", "cutter", "threshold", "materials"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/planId" },
        "wall": { "$ref": "#/definitions/planId" },
        "type": { "enum": ["door", "window", "plain"] },
        "shape": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "sill": { "type": "number", "minimum": 0 },
        "hinge": { "enum": ["start", "end"] },
        "swing": { "enum": ["left", "right"] },
        "frame": { "type": ["string", "null"] },
        "centre": { "$ref": "#/definitions/xy" },
        "tangent": { "$ref": "#/definitions/xy" },
        "right": { "$ref": "#/definitions/xy" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "curved": { "type": "boolean" },
        "outline": { "description": "The shape in the opening's own box, (u, v), anticlockwise.", "$ref": "#/definitions/points" },
        "inner_outline": {
          "description": "outline made smaller by the frame width; for doors and plain openings with sill 0 the bottom stays at v = 0. Empty when nothing is left.",
          "type": "array",
          "items": { "$ref": "#/definitions/xy" }
        },
        "cutter": {
          "description": "Two rings of the same length beyond each wall face; point i of both is the same outline point.",
          "type": "object",
          "required": ["right", "left"],
          "additionalProperties": false,
          "properties": {
            "right": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/xyz" } },
            "left": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/xyz" } }
          }
        },
        "threshold": {
          "description": "The cut through the wall band at floor level when the sill is 0, so the floor carries on through. Empty otherwise.",
          "type": "array",
          "items": { "$ref": "#/definitions/xy" }
        },
        "materials": {
          "description": "reveal: the faces the cut makes. threshold: the threshold face (when there is one). door, frame, glass, handle: the parts of the fill.",
          "type": "object",
          "required": ["reveal", "threshold", "door", "frame", "glass", "handle"],
          "additionalProperties": false,
          "properties": {
            "reveal": { "$ref": "#/definitions/materialRef" },
            "threshold": { "$ref": "#/definitions/materialRef" },
            "door": { "$ref": "#/definitions/materialRef" },
            "frame": { "$ref": "#/definitions/materialRef" },
            "glass": { "$ref": "#/definitions/materialRef" },
            "handle": { "$ref": "#/definitions/materialRef" }
          }
        }
      }
    }
  }
}
