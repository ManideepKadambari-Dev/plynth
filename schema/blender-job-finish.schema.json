{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plynth:schema:blender-job-finish:1",
  "title": "Plynth build job finishing fields",
  "description": "The optional fields a build job's floors carry for catalog doors and windows, trim, set dressing and lights. They are joined to blender-job.schema.json by reference, so a job without them stays valid. Positions are world metres (X plan x, Y minus plan y, Z up from the first floor's level). The root accepts one floor's finishing fields, for tests.",
  "type": "object",
  "properties": {
    "openings": { "type": "array", "items": { "$ref": "#/definitions/openingFinish" } },
    "trim": { "$ref": "#/definitions/trimList" },
    "dressing": { "$ref": "#/definitions/dressingList" },
    "lights": { "$ref": "#/definitions/lightList" }
  },
  "definitions": {
    "catalogId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
    "planId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "openingFinish": {
      "description": "The extra field of one opening entry: the catalog asset fitted into it.",
      "type": "object",
      "properties": { "asset": { "$ref": "#/definitions/openingAsset" } }
    },
    "openingAsset": {
      "type": "object",
      "required": ["id", "location", "rotation_z", "scale"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/catalogId" },
        "location": { "$ref": "#/definitions/vec3" },
        "rotation_z": { "description": "Radians about Z.", "type": "number" },
        "scale": { "description": "Along the asset's own axes. A negative x mirrors it.", "$ref": "#/definitions/vec3" }
      }
    },
    "sweep": {
      "type": "object",
      "required": ["closed", "sections"],
      "additionalProperties": false,
      "properties": {
        "closed": { "type": "boolean" },
        "sections": {
          "description": "Rings of world points, each with the same count. A post is a sweep of two sections.",
          "type": "array",
          "minItems": 2,
          "items": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/vec3" } }
        }
      }
    },
    "trimEntry": {
      "type": "object",
      "required": ["kind", "plan_id", "object", "plynth_kind", "slot", "sweeps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["skirting", "cornice", "casing", "sill", "railing", "guard"] },
        "plan_id": { "$ref": "#/definitions/planId" },
        "object": { "description": "A plain object name with no engine prefix, for example f1_Skirting.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "plynth_kind": { "enum": ["trim", "railing", "guard"] },
        "slot": { "type": "string", "minLength": 1 },
        "material": { "oneOf": [{ "$ref": "#/definitions/catalogId" }, { "type": "null" }] },
        "sweeps": { "type": "array", "items": { "$ref": "#/definitions/sweep" } }
      }
    },
    "trimList": { "type": "array", "items": { "$ref": "#/definitions/trimEntry" } },
    "size": {
      "type": "object",
      "required": ["width", "depth", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "dressingEntry": {
      "type": "object",
      "required": ["id", "room", "rule", "host", "asset", "location", "rotation_z", "size"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "room": { "$ref": "#/definitions/planId" },
        "rule": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "host": { "$ref": "#/definitions/planId" },
        "asset": { "$ref": "#/definitions/catalogId" },
        "location": { "$ref": "#/definitions/vec3" },
        "rotation_z": { "type": "number" },
        "size": { "$ref": "#/definitions/size" }
      }
    },
    "dressingList": { "type": "array", "items": { "$ref": "#/definitions/dressingEntry" } },
    "lightEntry": {
      "type": "object",
      "required": ["id", "kind", "location", "power", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/planId" },
        "kind": { "enum": ["ceiling", "wall", "standing"] },
        "location": { "$ref": "#/definitions/vec3" },
        "power": { "description": "Watts.", "type": "number", "exclusiveMinimum": 0 },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "lightList": { "type": "array", "items": { "$ref": "#/definitions/lightEntry" } }
  }
}
