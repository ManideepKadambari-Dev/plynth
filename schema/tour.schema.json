{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plynth:schema:tour:1",
  "title": "Plynth guided tour text, version 1",
  "description": "app/resources/tour.json, embedded in the app and read by core/include/plynth/core/Tour.h. controls maps a control id to its name and one or two plain sentences. An id ending in * covers every id that starts with the rest, and the longest such id wins. A control id is the tourId property of a widget or action. Shortcuts are read from the action when the card is shown, never written into the text.",
  "type": "object",
  "required": ["format", "version", "controls", "tours"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "plynth-tour" },
    "version": { "const": 1 },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "text"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "text": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "tours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["plan", "wall", "build_export", "assets", "materials"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["control", "screen"],
              "additionalProperties": false,
              "properties": {
                "control": { "type": "string", "minLength": 1 },
                "screen": { "enum": ["home", "plan", "wall", "build", "export", "assets", "materials"] }
              }
            }
          }
        }
      }
    }
  }
}
