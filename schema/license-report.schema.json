{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plynth:schema:license-report:1",
  "title": "Plynth license report, version 1",
  "description": "export/<Stem>_licenses.json in a project folder, written by an export when the license report is switched on (core/include/plynth/core/LicenseReport.h). The same content is written as plain text in <Stem>_licenses.txt. It lists the source, author and license of every asset and material the last build used. It is not legal advice.",
  "type": "object",
  "required": ["format", "version", "project", "plan_fingerprint", "items", "warnings"],
  "additionalProperties": false,
  "definitions": {
    "kind": { "enum": ["asset", "material"] }
  },
  "properties": {
    "format": { "const": "plynth-license-report" },
    "version": { "const": 1 },
    "project": { "type": "string" },
    "plan_fingerprint": { "type": "string" },
    "items": {
      "description": "Assets first, then materials, each sorted by id and listed once.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "name", "in_library", "author", "source", "license"],
        "additionalProperties": false,
        "properties": {
          "kind": { "$ref": "#/definitions/kind" },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "in_library": { "description": "False when the item is no longer in the library.", "type": "boolean" },
          "author": { "type": ["string", "null"] },
          "source": {
            "type": "object",
            "required": ["kind", "reference", "imported_at"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string" },
              "reference": { "description": "A file name without its folders, or a web address.", "type": "string" },
              "imported_at": { "type": ["string", "null"] }
            }
          },
          "license": {
            "type": "object",
            "required": ["id", "name", "url", "redistributable"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "redistributable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "kind", "id", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "enum": ["unknown_license", "missing_item", "missing_author", "personal_use"] },
          "kind": { "$ref": "#/definitions/kind" },
          "id": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
