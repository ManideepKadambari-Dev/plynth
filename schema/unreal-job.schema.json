{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plynth:schema:unreal-job:1",
  "title": "Plynth Unreal job, version 1",
  "description": "The file the Unreal Engine link writes for its script inside the editor (core/include/plynth/core/UnrealLink.h). The script imports what it lists into content_path, places one actor per mesh in the open level and writes result_file (unreal-result.schema.json). Paths are absolute, UTF-8, forward slashes; file entries are relative to source_folder.",
  "type": "object",
  "required": ["format", "version", "job_id", "plynth_version", "building", "project_folder", "content_path", "source_folder", "pack_materials", "grouped", "meshes", "kit", "textures", "materials", "data_files", "level", "checks", "result_file"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "plynth-unreal-job" },
    "version": { "const": 1 },
    "job_id": { "type": "string", "pattern": "^link-[0-9a-f]{8}$" },
    "plynth_version": { "type": "string" },
    "building": { "description": "The folder name under Content/Plynth.", "$ref": "#/definitions/assetName" },
    "project_folder": { "description": "The Plynth project folder, stored as the PlynthProject metadata tag.", "type": "string", "minLength": 1 },
    "content_path": { "type": "string", "pattern": "^/Game/Plynth/[A-Za-z0-9_-]+$" },
    "source_folder": { "type": "string", "minLength": 1 },
    "pack_materials": { "type": "boolean" },
    "grouped": { "type": "boolean" },
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["group", "file", "asset", "actor"],
        "additionalProperties": false,
        "properties": {
          "group": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.fbx$" },
          "asset": { "description": "The static mesh asset name in Meshes/.", "$ref": "#/definitions/assetName" },
          "actor": { "description": "The label of its actor in the level.", "$ref": "#/definitions/assetName" }
        }
      }
    },
    "kit": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["file", "pieces"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9_-]+_Kit\\.fbx$" },
            "pieces": { "type": "array", "items": { "$ref": "#/definitions/assetName" } }
          }
        }
      ]
    },
    "textures": {
      "description": "Empty when pack_materials is false.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "asset", "channel", "srgb"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^Textures/[A-Za-z0-9_.-]+$" },
          "asset": { "$ref": "#/definitions/assetName" },
          "channel": { "$ref": "#/definitions/channel" },
          "srgb": { "description": "True for base color only.", "type": "boolean" }
        }
      }
    },
    "materials": {
      "description": "One per material slot. Empty when pack_materials is false.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot", "asset", "blend", "two_sided", "maps", "values"],
        "additionalProperties": false,
        "properties": {
          "slot": { "$ref": "#/definitions/assetName" },
          "asset": { "description": "The material instance, MI_<slot>.", "$ref": "#/definitions/assetName" },
          "blend": { "enum": ["opaque", "masked", "translucent"] },
          "two_sided": { "type": "boolean" },
          "maps": {
            "type": "object",
            "required": ["base_color", "normal", "roughness", "metallic", "opacity", "occlusion"],
            "additionalProperties": false,
            "properties": {
              "base_color": { "$ref": "#/definitions/optionalAsset" },
              "normal": { "$ref": "#/definitions/optionalAsset" },
              "roughness": { "$ref": "#/definitions/optionalAsset" },
              "metallic": { "$ref": "#/definitions/optionalAsset" },
              "opacity": { "$ref": "#/definitions/optionalAsset" },
              "occlusion": { "$ref": "#/definitions/optionalAsset" }
            }
          },
          "values": {
            "description": "Used for a channel with no map.",
            "type": "object",
            "required": ["base_color", "roughness", "metallic", "opacity"],
            "additionalProperties": false,
            "properties": {
              "base_color": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
              "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
              "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "data_files": {
      "description": "Files copied as they are into Content/Plynth/<building>/Data/ on disk: the gameplay data and the license report.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
    },
    "level": {
      "type": "object",
      "required": ["place_actors", "tag"],
      "additionalProperties": false,
      "properties": {
        "place_actors": { "type": "boolean" },
        "tag": { "type": "string", "pattern": "^Plynth:[A-Za-z0-9_-]+$" }
      }
    },
    "checks": {
      "description": "For the headless test only; null in a normal delivery.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["expected_bounds", "screenshot"],
          "additionalProperties": false,
          "properties": {
            "expected_bounds": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["min", "max"],
                  "additionalProperties": false,
                  "properties": {
                    "min": { "$ref": "#/definitions/xyz" },
                    "max": { "$ref": "#/definitions/xyz" }
                  }
                },
                { "type": "null" }
              ]
            },
            "screenshot": { "oneOf": [ { "type": "string", "minLength": 1 }, { "type": "null" } ] }
          }
        }
      ]
    },
    "result_file": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "assetName": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 128 },
    "optionalAsset": { "oneOf": [ { "$ref": "#/definitions/assetName" }, { "type": "null" } ] },
    "channel": { "enum": ["base_color", "normal", "roughness", "metallic", "opacity", "occlusion"] },
    "xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
  }
}
